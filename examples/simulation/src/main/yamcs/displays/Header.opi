  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <actions hook="false" hook_all="false" />
    <alarm_pulsing>false</alarm_pulsing>
    <auto_size>false</auto_size>
    <backcolor_alarm_sensitive>false</backcolor_alarm_sensitive>
    <background_color>
      <color name="YSS Panel" red="35" green="41" blue="49" />
    </background_color>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <border_color>
      <color name="YSS Panel Border" red="52" green="60" blue="70" />
    </border_color>
    <border_style>1</border_style>
    <border_width>1</border_width>
    <enabled>true</enabled>
    <font>
      <fontdata fontName="Liberation Sans" height="11" style="1" pixels="true" />
    </font>
    <forecolor_alarm_sensitive>false</forecolor_alarm_sensitive>
    <foreground_color>
      <color name="YSS Text Muted" red="128" green="140" blue="154" />
    </foreground_color>
    <height>24</height>
    <horizontal_alignment>1</horizontal_alignment>
    <name>TM Status</name>
    <pv_name />
    <pv_value />
    <rules>
      <rule name="text" prop_id="text" out_exp="false">
        <exp bool_exp="pvSev0 == -1">
          <value>TM STALE</value>
        </exp>
        <exp bool_exp="true">
          <value>TM LIVE</value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/ElapsedTime</pv>
      </rule>
      <rule name="color" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pvSev0 == -1">
          <value>
            <color name="YSS Stale" red="196" green="92" blue="196" />
          </value>
        </exp>
        <exp bool_exp="true">
          <value>
            <color name="YSS Nominal" red="63" green="178" blue="127" />
          </value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/ElapsedTime</pv>
      </rule>
      <rule name="border" prop_id="border_color" out_exp="false">
        <exp bool_exp="pvSev0 == -1">
          <value>
            <color name="YSS Stale" red="196" green="92" blue="196" />
          </value>
        </exp>
        <exp bool_exp="true">
          <value>
            <color name="YSS Nominal" red="63" green="178" blue="127" />
          </value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/ElapsedTime</pv>
      </rule>
    </rules>
    <scale_options>
      <width_scalable>true</width_scalable>
      <height_scalable>true</height_scalable>
      <keep_wh_ratio>false</keep_wh_ratio>
    </scale_options>
    <scripts />
    <show_scrollbar>false</show_scrollbar>
    <text>NO TM</text>
    <tooltip />
    <transparent>true</transparent>
    <vertical_alignment>1</vertical_alignment>
    <visible>true</visible>
    <widget_type>Label</widget_type>
    <width>96</width>
    <wrap_words>false</wrap_words>
    <wuid>yss:10</wuid>
    <x>908</x>
    <y>16</y>
