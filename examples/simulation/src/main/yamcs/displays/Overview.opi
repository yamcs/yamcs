      <color name="YSS Text Muted" red="128" green="140" blue="154" />
    </foreground_color>
    <height>18</height>
    <horizontal_alignment>0</horizontal_alignment>
    <name>Label_36</name>
    <pv_name />
    <pv_value />
    <rules>
      <rule name="text" prop_id="text" out_exp="false">
        <exp bool_exp="pvSev0 == -1 || pvSev1 == -1">
          <value>STALE</value>
        </exp>
        <exp bool_exp="pvStr0 == 'true' || pvStr1 == 'true'">
          <value>CRITICAL TC ARMED</value>
        </exp>
        <exp bool_exp="true">
          <value>SAFE</value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/AllowCriticalTC1</pv>
        <pv trig="true">/YSS/SIMULATOR/AllowCriticalTC2</pv>
      </rule>
      <rule name="color" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pvSev0 == -1 || pvSev1 == -1">
          <value>
            <color name="YSS Stale" red="196" green="92" blue="196" />
          </value>
        </exp>
        <exp bool_exp="pvStr0 == 'true' || pvStr1 == 'true'">
          <value>
            <color name="YSS Caution" red="224" green="168" blue="79" />
          </value>
        </exp>
        <exp bool_exp="true">
          <value>
            <color name="YSS Nominal" red="63" green="178" blue="127" />
          </value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/AllowCriticalTC1</pv>
        <pv trig="true">/YSS/SIMULATOR/AllowCriticalTC2</pv>
      </rule>
    </rules>
