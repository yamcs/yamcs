    <name>TileStripe_2</name>
    <pv_name />
    <pv_value />
    <rules>
      <rule name="color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pvSev0 == -1 || pvSev1 == -1 || pvSev2 == -1">
          <value>
            <color name="YSS Stale" red="196" green="92" blue="196" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 == 1 || pvSev1 == 1 || pvSev2 == 1">
          <value>
            <color name="YSS Alarm" red="230" green="76" blue="76" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 == 2 || pvSev1 == 2 || pvSev2 == 2">
          <value>
            <color name="YSS Caution" red="224" green="168" blue="79" />
          </value>
        </exp>
        <exp bool_exp="true">
          <value>
            <color name="YSS Nominal" red="63" green="178" blue="127" />
          </value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/BatteryVoltage1</pv>
        <pv trig="true">/YSS/SIMULATOR/BatteryVoltage2</pv>
        <pv trig="true">/YSS/SIMULATOR/BatteryVoltage3</pv>
      </rule>
    </rules>
