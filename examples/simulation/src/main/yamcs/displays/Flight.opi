    <foreground_color>
      <color name="YSS Text" red="182" green="192" blue="203" />
    </foreground_color>
    <gradient>false</gradient>
    <height>314</height>
    <horizontal_fill>true</horizontal_fill>
    <line_color>
      <color name="YSS Panel Border" red="52" green="60" blue="70" />
    </line_color>
    <line_style>0</line_style>
    <line_width>1</line_width>
    <name>ADI Frame</name>
    <pv_name />
    <pv_value />
    <rules />
    <scale_options>
      <width_scalable>true</width_scalable>
      <height_scalable>true</height_scalable>
      <keep_wh_ratio>false</keep_wh_ratio>
    </scale_options>
    <scripts>
      <path pathString="EmbeddedJs" checkConnect="true" sfe="false" seoe="false">
        <scriptName>Attitude</scriptName>
        <scriptText>importPackage(Packages.org.csstudio.opibuilder.scriptUtil);
importPackage(Packages.org.eclipse.draw2d.geometry);

// Attitude indicator. pvs[0] = pitch (deg), pvs[1] = roll (deg).
// All shapes are computed from the same unrounded horizon position.
var C = 156;              // center of the instrument (container coordinates)
var PX_PER_DEG = 2.0;
var ROLL_RADIUS = 134;
var RUNGS = [-80, -70, -60, -50, -40, -30, -20, -10, 10, 20, 30, 40, 50, 60, 70, 80];
var RUNG_HALF = 28;
var MAX_OFFSET = 176;
var FAR = 405;          // reaches past the clip in every direction

var pitch = PVUtil.getDouble(pvs[0]);
var roll = PVUtil.getDouble(pvs[1]);

var rad = roll * Math.PI / 180;
// Horizon direction and its normal towards the ground (screen y points down)
var dx = Math.cos(rad), dy = -Math.sin(rad);
var nx = Math.sin(rad), ny = Math.cos(rad);

function toPoints(pts) {
    var i;
    if (typeof PointList !== "undefined") { // Yamcs Studio
        var pl = new PointList();
        for (i = 0; i &lt; pts.length; i++) {
            pl.addPoint(Math.round(pts[i][0]), Math.round(pts[i][1]));
        }
        return pl;
    }
    var arr = [];
    for (i = 0; i &lt; pts.length; i++) {
        arr.push({ x: pts[i][0], y: pts[i][1] });
    }
    return arr;
}

// Center of the line where the pitch equals 'a' degrees
function lineCenter(a) {
    var off = Math.max(-MAX_OFFSET, Math.min(MAX_OFFSET, (pitch - a) * PX_PER_DEG));
    return [C + nx * off, C + ny * off];
}

function segment(p, half) {
    return [[p[0] - dx * half, p[1] - dy * half], [p[0] + dx * half, p[1] + dy * half]];
}

var h = lineCenter(0);
display.getWidget("ADI Ground").setPropertyValue("points", toPoints([
    [h[0] - dx * FAR, h[1] - dy * FAR],
    [h[0] + dx * FAR, h[1] + dy * FAR],
    [h[0] + dx * FAR + nx * FAR, h[1] + dy * FAR + ny * FAR],
    [h[0] - dx * FAR + nx * FAR, h[1] - dy * FAR + ny * FAR]]));
display.getWidget("ADI Horizon").setPropertyValue("points", toPoints(segment(h, FAR)));

for (var i = 0; i &lt; RUNGS.length; i++) {
    var a = RUNGS[i];
    var p = lineCenter(a);
    var half = a % 20 == 0 ? RUNG_HALF : RUNG_HALF / 2;
    display.getWidget("ADI Rung " + a).setPropertyValue("points", toPoints(segment(p, half)));
    var text = display.getWidget("ADI Rung Label " + a);
    var t = RUNG_HALF + 14;
    text.setPropertyValue("x", Math.round(p[0] + dx * t - text.getPropertyValue("width") / 2));
    text.setPropertyValue("y", Math.round(p[1] + dy * t - text.getPropertyValue("height") / 2));
}

// Roll pointer rides on the roll scale and turns with the horizon
var ux = -Math.sin(rad), uy = -Math.cos(rad);
var tip = [C + ux * ROLL_RADIUS, C + uy * ROLL_RADIUS];
var back = [C + ux * (ROLL_RADIUS + 10), C + uy * (ROLL_RADIUS + 10)];
display.getWidget("ADI Roll Pointer").setPropertyValue("points", toPoints([tip,
    [back[0] - uy * 6, back[1] + ux * 6],
    [back[0] + uy * 6, back[1] - ux * 6]]));
</scriptText>
        <pv trig="false">/YSS/SIMULATOR/Theta</pv>
        <pv trig="true">/YSS/SIMULATOR/Phi</pv>
      </path>
    </scripts>
    <tooltip />
    <transparent>true</transparent>
    <visible>true</visible>
    <widget_type>Rectangle</widget_type>
    <width>314</width>
    <wuid>yss:208</wuid>
    <x>31</x>
    <y>111</y>
  </widget>
