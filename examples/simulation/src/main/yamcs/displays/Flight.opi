    <backcolor_alarm_sensitive>false</backcolor_alarm_sensitive>
    <background_color>
      <color name="YSS Panel" red="35" green="41" blue="49" />
    </background_color>
    <bg_gradient_color>
      <color name="YSS Panel" red="35" green="41" blue="49" />
    </bg_gradient_color>
    <border_alarm_sensitive>false</border_alarm_sensitive>
