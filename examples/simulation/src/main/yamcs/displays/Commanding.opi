    </foreground_color>
    <height>26</height>
    <horizontal_alignment>1</horizontal_alignment>
    <name>Label_205</name>
    <pv_name />
    <pv_value />
    <rules>
      <rule name="text" prop_id="text" out_exp="false">
        <exp bool_exp="pvStr0 == 'true'">
          <value>ARMED</value>
        </exp>
        <exp bool_exp="true">
          <value>SAFE</value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/AllowCriticalTC1</pv>
      </rule>
      <rule name="color" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pvStr0 == 'true'">
          <value>
            <color name="YSS Caution" red="224" green="168" blue="79" />
          </value>
        </exp>
        <exp bool_exp="true">
          <value>
            <color name="YSS Nominal" red="63" green="178" blue="127" />
          </value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/AllowCriticalTC1</pv>
      </rule>
      <rule name="border" prop_id="border_color" out_exp="false">
        <exp bool_exp="pvStr0 == 'true'">
          <value>
            <color name="YSS Caution" red="224" green="168" blue="79" />
          </value>
        </exp>
        <exp bool_exp="true">
          <value>
            <color name="YSS Nominal" red="63" green="178" blue="127" />
          </value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/AllowCriticalTC1</pv>
      </rule>
    </rules>
