      <fontdata fontName="Liberation Sans" height="11" style="1" pixels="true" />
    </font>
    <forecolor_alarm_sensitive>false</forecolor_alarm_sensitive>
    <foreground_color>
      <color name="YSS Text Muted" red="128" green="140" blue="154" />
    </foreground_color>
    <height>22</height>
    <horizontal_alignment>1</horizontal_alignment>
    <name>Label_214</name>
    <pv_name />
    <pv_value />
    <rules>
      <rule name="text" prop_id="text" out_exp="false">
        <exp bool_exp="pvInt0 == 0">
          <value>OK</value>
        </exp>
        <exp bool_exp="true">
          <value>FAILED</value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/avc_command_result</pv>
      </rule>
      <rule name="color" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pvInt0 == 0">
          <value>
            <color name="YSS Nominal" red="63" green="178" blue="127" />
          </value>
        </exp>
        <exp bool_exp="true">
          <value>
            <color name="YSS Alarm" red="230" green="76" blue="76" />
          </value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/avc_command_result</pv>
      </rule>
      <rule name="border" prop_id="border_color" out_exp="false">
        <exp bool_exp="pvInt0 == 0">
          <value>
            <color name="YSS Nominal" red="63" green="178" blue="127" />
          </value>
        </exp>
        <exp bool_exp="true">
          <value>
            <color name="YSS Alarm" red="230" green="76" blue="76" />
          </value>
        </exp>
        <pv trig="true">/YSS/SIMULATOR/avc_command_result</pv>
      </rule>
    </rules>
