<?xml version="1.0" encoding="UTF-8"?>
<SpaceSystem name="PUS19" xmlns="http://www.omg.org/spec/XTCE/20180204" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.omg.org/spec/XTCE/20180204 https://www.omg.org/spec/XTCE/20180204/SpaceSystem.xsd">
	<Header validationStatus="Unknown" version="1.0" date="2026-10-05T00:00:00Z">
		<NoteSet>
			<Note>Sample implementation of PUS19 event-action. The event-action definitions are identified by the event
			definition id only (the application process id of ECSS-E-ST-70-41C is not used); there can be one action per
			event.</Note>
		</NoteSet>
	</Header>
	<TelemetryMetaData>
		<ParameterTypeSet>
			<EnumeratedParameterType name="EventActionStatusType">
				<IntegerDataEncoding sizeInBits="8"/>
				<EnumerationList>
					<Enumeration value="0" label="disabled" />
					<Enumeration value="1" label="enabled" />
				</EnumerationList>
			</EnumeratedParameterType>
			<AggregateParameterType name="EventActionStatusElementType">
				<MemberList>
					<Member typeRef="/PUS5/event_id_type" name="event_id"/>
					<Member typeRef="EventActionStatusType" name="status"/>
				</MemberList>
			</AggregateParameterType>
			<ArrayParameterType arrayTypeRef="EventActionStatusElementType" name="EventActionStatusReportType">
				<DimensionList>
					<Dimension>
						<StartingIndex><FixedValue>0</FixedValue></StartingIndex>
						<EndingIndex><DynamicValue><ParameterInstanceRef parameterRef="status_report_n"/><LinearAdjustment intercept="-1"/></DynamicValue></EndingIndex>
					</Dimension>
				</DimensionList>
			</ArrayParameterType>
		</ParameterTypeSet>
		<ParameterSet>
			<Parameter parameterTypeRef="/dt/uint8" name="status_report_n"/>
			<Parameter parameterTypeRef="EventActionStatusReportType" name="status_report"
				shortDescription="Contains the status (enabled/disabled) of each event-action definition."/>
		</ParameterSet>
		<ContainerSet>
			<SequenceContainer name="pus19-tm">
				<EntryList/>
				<BaseContainer containerRef="/PUS/pus-tm">
					<RestrictionCriteria>
						<Comparison parameterRef="/PUS/type" comparisonOperator="==" value="19" />
					</RestrictionCriteria>
				</BaseContainer>
			</SequenceContainer>
			<SequenceContainer name="EVENT_ACTION_STATUS_REPORT" shortDescription="TM[19,7] event-action status report">
				<EntryList>
					<ParameterRefEntry parameterRef="status_report_n"/>
					<ArrayParameterRefEntry parameterRef="status_report"/>
				</EntryList>
				<BaseContainer containerRef="pus19-tm">
					<RestrictionCriteria>
						<Comparison parameterRef="/PUS/subtype" comparisonOperator="==" value="7" />
					</RestrictionCriteria>
				</BaseContainer>
			</SequenceContainer>
		</ContainerSet>
	</TelemetryMetaData>
	<CommandMetaData>
		<ArgumentTypeSet>
			<IntegerArgumentType name="NumDefinitionsType" baseType="/dt/uint8"/>
			<AggregateArgumentType name="EventActionType">
				<MemberList>
					<Member typeRef="/PUS5/event_id_type" name="event_id"/>
					<Member typeRef="/PUS/EmbeddedTcType" name="tc"/>
				</MemberList>
			</AggregateArgumentType>
			<ArrayArgumentType arrayTypeRef="EventActionType" name="EventActionArrayType">
				<DimensionList>
					<Dimension>
						<StartingIndex>
							<FixedValue>0</FixedValue>
						</StartingIndex>
						<EndingIndex>
							<DynamicValue>
								<ArgumentInstanceRef argumentRef="num_definitions" />
								<LinearAdjustment intercept="-1" />
							</DynamicValue>
						</EndingIndex>
					</Dimension>
				</DimensionList>
			</ArrayArgumentType>
			<ArrayArgumentType arrayTypeRef="/PUS5/event_id_type" name="EventIdArrayType">
				<DimensionList>
					<Dimension>
						<StartingIndex>
							<FixedValue>0</FixedValue>
						</StartingIndex>
						<EndingIndex>
							<DynamicValue>
								<ArgumentInstanceRef argumentRef="num_definitions" />
								<LinearAdjustment intercept="-1" />
							</DynamicValue>
						</EndingIndex>
					</Dimension>
				</DimensionList>
			</ArrayArgumentType>
		</ArgumentTypeSet>
		<MetaCommandSet>
			<MetaCommand name="pus19-tc" abstract="true">
				<BaseMetaCommand metaCommandRef="/PUS/pus-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="apid" argumentValue="1" />
						<ArgumentAssignment argumentName="type" argumentValue="19" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="pus19-tc">
					<EntryList/>
				</CommandContainer>
			</MetaCommand>

			<MetaCommand name="ADD_EVENT_ACTIONS" shortDescription="TC[19,1] add event-action definitions">
				<LongDescription>The tc of each definition is a complete TC packet given in hex (for example the binary obtained from a dry run of the command); it is executed each time the event is reported, if both the definition and the event-action function are enabled. Its sequence count, length and CRC are filled in by the command post-processor (the type is annotated with Yamcs:EmbeddedTc). New definitions are disabled.</LongDescription>
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="1" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<ArgumentList>
					<Argument argumentTypeRef="NumDefinitionsType" name="num_definitions"></Argument>
					<Argument argumentTypeRef="EventActionArrayType" name="definitions"></Argument>
				</ArgumentList>
				<CommandContainer name="ADD_EVENT_ACTIONS">
					<EntryList>
						<ArgumentRefEntry argumentRef="num_definitions"/>
						<ArgumentRefEntry argumentRef="definitions"/>
					</EntryList>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<MetaCommand name="DELETE_EVENT_ACTIONS" shortDescription="TC[19,2] delete event-action definitions">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="2" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<ArgumentList>
					<Argument argumentTypeRef="NumDefinitionsType" name="num_definitions"></Argument>
					<Argument argumentTypeRef="EventIdArrayType" name="event_ids"></Argument>
				</ArgumentList>
				<CommandContainer name="DELETE_EVENT_ACTIONS">
					<EntryList>
						<ArgumentRefEntry argumentRef="num_definitions"/>
						<ArgumentRefEntry argumentRef="event_ids"/>
					</EntryList>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<MetaCommand name="DELETE_ALL_EVENT_ACTIONS" shortDescription="TC[19,3] delete all event-action definitions">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="3" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="DELETE_ALL_EVENT_ACTIONS">
					<EntryList/>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<MetaCommand name="ENABLE_EVENT_ACTIONS" shortDescription="TC[19,4] enable event-action definitions (num_definitions=0 enables all)">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="4" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<ArgumentList>
					<Argument argumentTypeRef="NumDefinitionsType" name="num_definitions"></Argument>
					<Argument argumentTypeRef="EventIdArrayType" name="event_ids"></Argument>
				</ArgumentList>
				<CommandContainer name="ENABLE_EVENT_ACTIONS">
					<EntryList>
						<ArgumentRefEntry argumentRef="num_definitions"/>
						<ArgumentRefEntry argumentRef="event_ids"/>
					</EntryList>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<MetaCommand name="DISABLE_EVENT_ACTIONS" shortDescription="TC[19,5] disable event-action definitions (num_definitions=0 disables all)">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="5" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<ArgumentList>
					<Argument argumentTypeRef="NumDefinitionsType" name="num_definitions"></Argument>
					<Argument argumentTypeRef="EventIdArrayType" name="event_ids"></Argument>
				</ArgumentList>
				<CommandContainer name="DISABLE_EVENT_ACTIONS">
					<EntryList>
						<ArgumentRefEntry argumentRef="num_definitions"/>
						<ArgumentRefEntry argumentRef="event_ids"/>
					</EntryList>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<MetaCommand name="REPORT_STATUS" shortDescription="TC[19,6] report the status of each event-action definition">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="6" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="REPORT_STATUS">
					<EntryList/>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<MetaCommand name="ENABLE_FUNCTION" shortDescription="TC[19,8] enable the event-action function">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="8" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="ENABLE_FUNCTION">
					<EntryList/>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<MetaCommand name="DISABLE_FUNCTION" shortDescription="TC[19,9] disable the event-action function">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="9" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="DISABLE_FUNCTION">
					<EntryList/>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>
		</MetaCommandSet>
	</CommandMetaData>
</SpaceSystem>
