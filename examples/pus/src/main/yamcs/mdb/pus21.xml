			<StringArgumentType name="seq_id_arg_type">
				<StringDataEncoding>
					<SizeInBits>
						<Fixed><FixedValue>128</FixedValue></Fixed>
					</SizeInBits>
				</StringDataEncoding>
			</StringArgumentType>

			<!-- TC[21,1]: each entry embeds a complete, self-length-delimited raw TC packet.
			     No SizeInBits at all -> BinaryDataEncoding defaults to FIXED_SIZE, sizeInBits=-1 ->
			     encoder writes exactly the bytes supplied by the caller, zero framing
			     (DataEncodingEncoder.encodeRawBinary()). This is what makes the entry
			     self-length-delimited on the wire instead of relying on an invented sibling length
			     field; the on-board software (and the simulator emulating it) finds each entry's
			     boundary by reading the embedded packet's own CCSDS length field. -->
			<BinaryArgumentType name="tc_packet_arg_type" />
			<AggregateArgumentType name="seq_entry_type">
				<MemberList>
					<Member typeRef="tc_packet_arg_type" name="tc_packet" />
