<?xml version="1.0" encoding="UTF-8"?>
<SpaceSystem name="PUS19" xmlns="http://www.omg.org/spec/XTCE/20180204" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.omg.org/spec/XTCE/20180204 https://www.omg.org/spec/XTCE/20180204/SpaceSystem.xsd">
	<Header validationStatus="Unknown" version="1.0" date="2026-07-20T00:00:00Z">
		<NoteSet>
			<Note>ST[19] Event-Action Service. See pus_analysis/pus19.md and pus_simulator_architecture.md
				for the full design rationale. In-scope subtypes: TC[19,1/2/4/5/6/8/9/10], TM[19,7/11].
				TC[19,3] (delete all definitions) is out of scope, matching pus19.md.</Note>
			<Note>Event system identifier: (app_process_id, event_def_id), both uint16. This simulator has
				a single application process (MAIN_APID=1); Pus5Service notifies Pus19Service.onEvent with
				app_process_id fixed to MAIN_APID whenever it raises an event, so ground-side definitions
				should always use app_process_id=1.</Note>
			<Note>Embedded TC packet (TC[19,1] and TM[19,11] "request" field): a complete TC packet with no
				length prefix, as specified in ECSS-E-ST-70-41C 8.19.2.1. TC side: the request uses
				/PUS/EmbeddedTcType (annotated Yamcs:EmbeddedTc), so the PusCommandPostprocessor fills in its
				sequence count and length and appends its CRC (embeddedTcCrc); the request can be entered as
				the binary of a dry run of the command. TM side: the request size is taken from the embedded
				packet's own CCSDS packet data length field, read ahead and then decoded as one binary
				parameter (see ea_def_entry).</Note>
			<Note>TC[19,4]/TC[19,5] (enable/disable definitions) use the two-MetaCommand "_SPECIFIC"/"_ALL"
				zero-payload pattern (per spec section 6.19.7.1b), same as ST[15]'s dual-variant TCs.
				TC[19,10] (report definitions) instead uses the spec's in-band N=0 convention (section
				8.19.2.10c) as a single MetaCommand -- N=0 naturally yields a zero-length array.</Note>
		</NoteSet>
	</Header>
	<TelemetryMetaData>
		<ParameterTypeSet>
			<!-- Table 8-20: per-definition event-action status -->
			<EnumeratedParameterType name="ea_status_type">
				<IntegerDataEncoding sizeInBits="8" />
				<EnumerationList>
					<Enumeration value="0" label="disabled" />
					<Enumeration value="1" label="enabled" />
				</EnumerationList>
			</EnumeratedParameterType>

			<IntegerParameterType name="ea_count_type" baseType="/dt/uint8" />

			<!-- TM[19,7] status report: fixed-size entries, safe to model as a flat array -->
			<AggregateParameterType name="ea_status_entry_type">
				<MemberList>
					<Member typeRef="/dt/uint16" name="app_process_id" />
					<Member typeRef="/dt/uint16" name="event_def_id" />
					<Member typeRef="ea_status_type" name="ea_status" />
				</MemberList>
			</AggregateParameterType>
			<ArrayParameterType arrayTypeRef="ea_status_entry_type" name="ea_status_array_type">
				<DimensionList>
					<Dimension>
						<StartingIndex><FixedValue>0</FixedValue></StartingIndex>
						<EndingIndex>
							<DynamicValue>
								<ParameterInstanceRef parameterRef="ea_status_count" />
								<LinearAdjustment intercept="-1" />
							</DynamicValue>
						</EndingIndex>
					</Dimension>
				</DimensionList>
			</ArrayParameterType>

			<!-- TM[19,11] definition report: entries carry a variable-length embedded request TC, so
			     they cannot use a flat ArrayParameterType. Decoded instead via nested ContainerRefEntry +
			     RepeatEntry (see ea_def_entry container below). The request is a complete TC packet whose
			     total size is its CCSDS packet data length + 7 bytes. -->
			<BinaryParameterType name="ea_request_data_type">
				<BinaryDataEncoding>
					<SizeInBits>
						<DynamicValue>
							<ParameterInstanceRef parameterRef="ea11_request_pkt_len" />
							<LinearAdjustment slope="8" intercept="56" />
						</DynamicValue>
					</SizeInBits>
				</BinaryDataEncoding>
			</BinaryParameterType>
		</ParameterTypeSet>
		<ParameterSet>
			<Parameter parameterTypeRef="ea_count_type" name="ea_status_count" />
			<Parameter parameterTypeRef="ea_status_array_type" name="ea_status_entries" />

			<Parameter parameterTypeRef="ea_count_type" name="ea11_count" />
			<Parameter parameterTypeRef="/dt/uint16" name="ea11_app_process_id" />
			<Parameter parameterTypeRef="/dt/uint16" name="ea11_event_def_id" />
			<Parameter parameterTypeRef="ea_status_type" name="ea11_status" />
			<Parameter parameterTypeRef="/dt/uint16" name="ea11_request_pkt_len"
				shortDescription="CCSDS packet data length field of the embedded request (total size - 7)" />
			<Parameter parameterTypeRef="ea_request_data_type" name="ea11_request_data" />
		</ParameterSet>
		<ContainerSet>
			<SequenceContainer name="pus19-tm">
				<EntryList />
				<BaseContainer containerRef="/PUS/pus-tm">
					<RestrictionCriteria>
						<Comparison parameterRef="/PUS/type" comparisonOperator="==" value="19" />
					</RestrictionCriteria>
				</BaseContainer>
			</SequenceContainer>

			<!-- TM[19,7] Event-action status report -->
			<SequenceContainer name="TM_19_7" shortDescription="TM[19,7] Event-action status report">
				<EntryList>
					<ParameterRefEntry parameterRef="ea_status_count" />
					<ArrayParameterRefEntry parameterRef="ea_status_entries">
						<IncludeCondition>
							<Comparison parameterRef="ea_status_count" comparisonOperator="&gt;" value="0" />
						</IncludeCondition>
					</ArrayParameterRefEntry>
				</EntryList>
				<BaseContainer containerRef="pus19-tm">
					<RestrictionCriteria>
						<Comparison parameterRef="/PUS/subtype" comparisonOperator="==" value="7" />
					</RestrictionCriteria>
				</BaseContainer>
			</SequenceContainer>

			<!-- One TM[19,11] entry: fixed identifier/status fields + the embedded request TC. The
			     request's CCSDS packet data length (bytes 4-5 of the request) is read ahead first, then
			     the position goes back 48 bits to the start of the request, which is decoded in one piece
			     with the size derived from that length.
			     LIMITATION: Yamcs resolves a ParameterInstanceRef in a DynamicValue to the first instance in
			     the packet (PACKET_START_WITHIN_PACKET, instance 0), so every entry's request is sized by the
			     first entry's length. Reports whose requests all have the same length (or a single entry,
			     e.g. TC[19,10] for one definition) decode correctly; others fail after the first entry.
			     Free-standing container (no BaseContainer) only reached via the ContainerRefEntry below. -->
			<SequenceContainer name="ea_def_entry">
				<EntryList>
					<ParameterRefEntry parameterRef="ea11_app_process_id" />
					<ParameterRefEntry parameterRef="ea11_event_def_id" />
					<ParameterRefEntry parameterRef="ea11_status" />
					<ParameterRefEntry parameterRef="ea11_request_pkt_len">
						<LocationInContainerInBits referenceLocation="previousEntry">
							<FixedValue>32</FixedValue>
						</LocationInContainerInBits>
					</ParameterRefEntry>
					<ParameterRefEntry parameterRef="ea11_request_data">
						<LocationInContainerInBits referenceLocation="previousEntry">
							<FixedValue>-48</FixedValue>
						</LocationInContainerInBits>
					</ParameterRefEntry>
				</EntryList>
			</SequenceContainer>

			<!-- TM[19,11] Event-action definition report -->
			<SequenceContainer name="TM_19_11" shortDescription="TM[19,11] Event-action definition report">
				<EntryList>
					<ParameterRefEntry parameterRef="ea11_count" />
					<ContainerRefEntry containerRef="ea_def_entry">
						<RepeatEntry>
							<Count>
								<DynamicValue>
									<ParameterInstanceRef parameterRef="ea11_count" />
								</DynamicValue>
							</Count>
						</RepeatEntry>
					</ContainerRefEntry>
				</EntryList>
				<BaseContainer containerRef="pus19-tm">
					<RestrictionCriteria>
						<Comparison parameterRef="/PUS/subtype" comparisonOperator="==" value="11" />
					</RestrictionCriteria>
				</BaseContainer>
			</SequenceContainer>
		</ContainerSet>
	</TelemetryMetaData>

	<CommandMetaData>
		<ArgumentTypeSet>
			<!-- Reusable (app_process_id, event_def_id) identifier pair, used by TC[19,2],
			     TC[19,4]_SPECIFIC, TC[19,5]_SPECIFIC and TC[19,10]. Each such MetaCommand declares its
			     own top-level "N" argument; the sibling ArgumentInstanceRef below resolves to it
			     (same reuse pattern as pus15.xml's store_id_array_type). -->
			<AggregateArgumentType name="event_id_entry_type">
				<MemberList>
					<Member typeRef="/dt/uint16" name="app_process_id" />
					<Member typeRef="/dt/uint16" name="event_def_id" />
				</MemberList>
			</AggregateArgumentType>
			<ArrayArgumentType arrayTypeRef="event_id_entry_type" name="event_id_array_type">
				<DimensionList>
					<Dimension>
						<StartingIndex><FixedValue>0</FixedValue></StartingIndex>
						<EndingIndex>
							<DynamicValue>
								<ArgumentInstanceRef argumentRef="N" />
								<LinearAdjustment intercept="-1" />
							</DynamicValue>
						</EndingIndex>
					</Dimension>
				</DimensionList>
			</ArrayArgumentType>

			<!-- TC[19,1] Add: each entry embeds the request TC with no length prefix (ECSS 8.19.2.1).
			     /PUS/EmbeddedTcType writes exactly the supplied bytes; the post-processor then fills in
			     the embedded packet's length and sequence count and appends its CRC. -->
			<AggregateArgumentType name="ea_add_entry_type">
				<MemberList>
					<Member typeRef="/dt/uint16" name="app_process_id" />
					<Member typeRef="/dt/uint16" name="event_def_id" />
					<Member typeRef="/PUS/EmbeddedTcType" name="request" />
				</MemberList>
			</AggregateArgumentType>
			<ArrayArgumentType arrayTypeRef="ea_add_entry_type" name="ea_add_array_type">
				<DimensionList>
					<Dimension>
						<StartingIndex><FixedValue>0</FixedValue></StartingIndex>
						<EndingIndex>
							<DynamicValue>
								<ArgumentInstanceRef argumentRef="N" />
								<LinearAdjustment intercept="-1" />
							</DynamicValue>
						</EndingIndex>
					</Dimension>
				</DimensionList>
			</ArrayArgumentType>
		</ArgumentTypeSet>
		<MetaCommandSet>
			<MetaCommand name="pus19-tc" abstract="true">
				<BaseMetaCommand metaCommandRef="/PUS/pus-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="apid" argumentValue="1" />
						<ArgumentAssignment argumentName="type" argumentValue="19" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="pus19-tc">
					<EntryList />
				</CommandContainer>
			</MetaCommand>

			<!-- TC[19,1] Add event-action definitions -->
			<MetaCommand name="TC_19_1_ADD" shortDescription="TC[19,1] Add event-action definitions">
				<LongDescription>Each entry's request is a complete TC packet given in hex (for example the binary obtained from a dry run of the command). Its sequence count, length and CRC are filled in by the command post-processor; they can be left zero and the CRC can be omitted. Adding an existing, disabled definition replaces its request; adding over an enabled definition is rejected (ECSS 6.19.8.1).</LongDescription>
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="1" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<ArgumentList>
					<Argument name="N" argumentTypeRef="/dt/uint8" />
					<Argument name="entries" argumentTypeRef="ea_add_array_type" />
				</ArgumentList>
				<CommandContainer name="TC_19_1_ADD">
					<EntryList>
						<ArgumentRefEntry argumentRef="N" />
						<ArgumentRefEntry argumentRef="entries" />
					</EntryList>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<!-- TC[19,2] Delete event-action definitions. Unknown or enabled definitions are rejected per instruction; the valid ones are still deleted (6.19.8.3d-f) -->
			<MetaCommand name="TC_19_2_DELETE" shortDescription="TC[19,2] Delete event-action definitions">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="2" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<ArgumentList>
					<Argument name="N" argumentTypeRef="/dt/uint8" />
					<Argument name="event_ids" argumentTypeRef="event_id_array_type" />
				</ArgumentList>
				<CommandContainer name="TC_19_2_DELETE">
					<EntryList>
						<ArgumentRefEntry argumentRef="N" />
						<ArgumentRefEntry argumentRef="event_ids" />
					</EntryList>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<!-- TC[19,4] Enable event-action definitions -->
			<MetaCommand name="TC_19_4_SPECIFIC" shortDescription="TC[19,4] Enable specific event-action definitions">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="4" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<ArgumentList>
					<Argument name="N" argumentTypeRef="/dt/uint8" />
					<Argument name="event_ids" argumentTypeRef="event_id_array_type" />
				</ArgumentList>
				<CommandContainer name="TC_19_4_SPECIFIC">
					<EntryList>
						<ArgumentRefEntry argumentRef="N" />
						<ArgumentRefEntry argumentRef="event_ids" />
					</EntryList>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>
			<MetaCommand name="TC_19_4_ALL" shortDescription="TC[19,4] Enable ALL event-action definitions">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="4" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="TC_19_4_ALL">
					<EntryList />
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<!-- TC[19,5] Disable event-action definitions -->
			<MetaCommand name="TC_19_5_SPECIFIC" shortDescription="TC[19,5] Disable specific event-action definitions">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="5" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<ArgumentList>
					<Argument name="N" argumentTypeRef="/dt/uint8" />
					<Argument name="event_ids" argumentTypeRef="event_id_array_type" />
				</ArgumentList>
				<CommandContainer name="TC_19_5_SPECIFIC">
					<EntryList>
						<ArgumentRefEntry argumentRef="N" />
						<ArgumentRefEntry argumentRef="event_ids" />
					</EntryList>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>
			<MetaCommand name="TC_19_5_ALL" shortDescription="TC[19,5] Disable ALL event-action definitions">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="5" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="TC_19_5_ALL">
					<EntryList />
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<!-- TC[19,6] Report status of each event-action definition (zero payload, triggers TM[19,7]) -->
			<MetaCommand name="TC_19_6_REPORT_STATUS" shortDescription="TC[19,6] Report event-action status">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="6" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="TC_19_6_REPORT_STATUS">
					<EntryList />
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<!-- TC[19,8] Enable the event-action function (zero payload) -->
			<MetaCommand name="TC_19_8_ENABLE_FUNCTION" shortDescription="TC[19,8] Enable the event-action function">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="8" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="TC_19_8_ENABLE_FUNCTION">
					<EntryList />
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<!-- TC[19,9] Disable the event-action function (zero payload) -->
			<MetaCommand name="TC_19_9_DISABLE_FUNCTION" shortDescription="TC[19,9] Disable the event-action function">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="9" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<CommandContainer name="TC_19_9_DISABLE_FUNCTION">
					<EntryList />
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>

			<!-- TC[19,10] Report event-action definitions (N=0 means "all", in-band per §8.19.2.10c) -->
			<MetaCommand name="TC_19_10_REPORT_DEFS" shortDescription="TC[19,10] Report event-action definitions (N=0 = all)">
				<BaseMetaCommand metaCommandRef="pus19-tc">
					<ArgumentAssignmentList>
						<ArgumentAssignment argumentName="subtype" argumentValue="10" />
					</ArgumentAssignmentList>
				</BaseMetaCommand>
				<ArgumentList>
					<Argument name="N" argumentTypeRef="/dt/uint8" />
					<Argument name="event_ids" argumentTypeRef="event_id_array_type" />
				</ArgumentList>
				<CommandContainer name="TC_19_10_REPORT_DEFS">
					<EntryList>
						<ArgumentRefEntry argumentRef="N" />
						<ArgumentRefEntry argumentRef="event_ids" />
					</EntryList>
					<BaseContainer containerRef="pus19-tc" />
				</CommandContainer>
			</MetaCommand>
		</MetaCommandSet>
	</CommandMetaData>
</SpaceSystem>
